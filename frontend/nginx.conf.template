server {
    listen 80;
    root /usr/share/nginx/html;

    # Same job as the Vite dev proxy: /api goes to the gateway, which strips the prefix.
    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $http_host;
        # Overwrite (not append to) the header so a client can't forge its address
        # and dodge the gateway's login rate limit.
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # react-router: unknown paths (e.g. a refresh on /residents) serve the app.
    location / {
        try_files $uri /index.html;
    }
}
