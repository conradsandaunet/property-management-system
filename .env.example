# Used by `docker compose up`. Copy to .env (gitignored) and fill in.
# JWT_SECRET: at least 32 characters, shared by all services and the gateway.
JWT_SECRET=change-this-to-a-random-32-byte-string
BOARD_SEED_PASSWORD=change-this-password
WORKER_SEED_PASSWORD=change-this-password
# Optional:
# FRONTEND_PORT=3000
# CORS_ALLOWED_ORIGINS=http://localhost:*
